{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/env.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.js",
		"vite.config.ts",
		"platform/routes/**/*.js",
		"platform/routes/**/*.ts",
		"platform/routes/**/*.svelte",
		"platform/lib/**/*.js",
		"platform/lib/**/*.ts",
		"platform/lib/**/*.svelte",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"test/**/*.js",
		"test/**/*.ts",
		"test/**/*.svelte",
		"tests/**/*.js",
		"tests/**/*.ts",
		"tests/**/*.svelte",
		"platform/components/**/*.js",
		"platform/components/**/*.ts",
		"platform/components/**/*.svelte",
		"processes/**/*.js",
		"processes/**/*.ts",
		"data/**/*.js",
		"data/**/*.ts",
		".config/**/*.ts"
	]
}
